# Copy to .env (untracked) and fill in locally. Never commit values.
# The server reads these names; the browser build reads the NAUTILUS_* build
# variables from frontend/.env.local, not from this file.

# --- Server: model access (secret; server-side only) -----------------------
MODEL_API_KEY=

# --- Server: paid Muse routes (disabled by default) ------------------------
# Only the exact value "true" opens the server-side guard. Leave blank to keep
# every paid route closed.
NAUTILUS_MUSE_ENABLED=
# Shared demo token for operator-only paid routes (secret; constant-time check).
NAUTILUS_DEMO_TOKEN=
# Non-secret model selector / provider reasoning setting.
NAUTILUS_MUSE_MODEL=
NAUTILUS_MUSE_REASONING_EFFORT=
# Spend guards.
NAUTILUS_MUSE_DAILY_LIMIT=
NAUTILUS_MUSE_MONTHLY_BUDGET_USD=

# --- Server: CORS ----------------------------------------------------------
# Exact frontend origin allowed to call the API, e.g. http://127.0.0.1:3000
NAUTILUS_ALLOWED_ORIGIN=

# --- Server: optional shared budget/ledger store (secrets) ----------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Frontend build (put these in frontend/.env.local) --------------------
# Empty API base means same-origin / the Vite proxy.
NAUTILUS_API_BASE=
# Set to "false" only for a deliberately API-less static build.
NAUTILUS_API_ENABLED=
# Asset base path; default "./".
NAUTILUS_BASE=
